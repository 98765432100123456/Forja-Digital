# Copia este archivo como .env.local para desarrollo. Nunca subas .env reales.
# ID público de Google Analytics 4 (no es un secreto: termina en el navegador).
VITE_GA_ID=

# Verificación de Google Search Console y Bing (códigos públicos de la etiqueta meta, sin la etiqueta completa)
VITE_GSC_VERIFICATION=
VITE_BING_VERIFICATION=
